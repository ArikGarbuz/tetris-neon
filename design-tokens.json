    "unit": "1rem = 16px",
    "scale": {
      "xs": "0.25rem",
      "sm": "0.5rem",
      "md": "1rem",
      "lg": "1.5rem",
      "xl": "2rem",
      "2xl": "3rem"
    }
  },
  "breakpoints": {
    "mobile": "< 600px",
    "tablet": "601px - 1024px",
    "desktop": ">= 1025px"
  },
  "components": {
    "button": {
      "padding": "0.5rem 1rem",
      "border": "1px solid rgba(0, 245, 255, 0.5)",
      "borderRadius": "4px",
      "background": "rgba(0, 0, 20, 0.8)",
      "color": "#00f5ff",
      "fontWeight": 600,
      "cursor": "pointer",
      "transition": "all 0.3s ease",
      "hover": {
        "boxShadow": "0 0 12px rgba(0, 245, 255, 0.4), inset 0 0 12px rgba(0, 245, 255, 0.1)"
      },
      "active": {
        "background": "rgba(0, 245, 255, 0.1)"
      }
    },
    "input": {
      "padding": "0.5rem 0.75rem",
      "border": "1px solid rgba(0, 245, 255, 0.3)",
      "borderRadius": "4px",
      "background": "rgba(0, 0, 20, 0.9)",
      "color": "#ddd",
      "fontFamily": "Courier New, monospace",
      "fontSize": "1rem",
      "focus": {
        "outline": "none",
        "borderColor": "rgba(0, 245, 255, 0.8)",
        "boxShadow": "0 0 8px rgba(0, 245, 255, 0.2)"
      }
    },
    "panel": {
      "border": "1px solid rgba(0, 245, 255, 0.25)",
      "borderRadius": "4px",
      "background": "rgba(0, 0, 20, 0.75)",
      "padding": "1rem",
      "boxShadow": "inset 0 0 8px rgba(0, 0, 0, 0.5)",
      "glowEffect": "0 0 12px rgba(0, 245, 255, 0.08)"
    },
    "gameCanvas": {
      "border": "2px solid rgba(0, 245, 255, 0.5)",
      "boxShadow": "0 0 25px rgba(0, 245, 255, 0.3)"
    }
  },
  "animations": {
    "flicker": {
      "duration": "3s",
      "iteration": "infinite",
      "description": "Subtle flicker effect for title"
    },
    "blink": {
      "duration": "1.1s",
      "iteration": "infinite",
      "description": "Message blinking"
    },
    "pulse": {
      "duration": "2s",
      "iteration": "infinite",
      "description": "Glow pulse effect"
    },
    "screenShake": {
      "duration": "0.3s",
      "description": "Shake on line clear"
    }
  },
  "visualEffects": {
    "scanlines": {
      "description": "Horizontal repeating gradient",
      "opacity": 0.12,
      "height": "1px",
      "color": "black"
    },
    "gridBackground": {
      "description": "40×40px grid pattern",
      "color": "#00f5ff",
      "opacity": 0.025
    }
  }
